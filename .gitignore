# ============================================================
#  Beverage Demand Forecasting — .gitignore
#  AI in Operations · SP Jain MAIB · Rakshanda Dhote
# ============================================================

# ---- Secrets (NEVER commit) ----
.env
.env.local
.env.*.local
*.key
*secret*
*.pem

# ---- Chatbot runtime artefacts ----
# These are generated at runtime by serve.py and may contain personal
# queries / model responses. Keep them out of version control.
chatbot_log.jsonl
chatbot_log.*.jsonl

# ---- Temp PDFs / scratch files ----
_ppt.pdf
_exec.pdf
_scratch_*
*.tmp
*.bak

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
develop-eggs/
.installed.cfg
pip-log.txt
pip-delete-this-directory.txt

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/
.python-version

# ---- Jupyter ----
.ipynb_checkpoints/
*.ipynb_checkpoints
*-checkpoint.ipynb
.jupyter/

# ---- Testing / coverage ----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache

# ---- Type checkers / linters ----
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# ---- IDE / editor ----
.vscode/
.idea/
*.swp
*.swo
*~
.spyderproject
.spyproject

# ---- OS noise ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---- Logs ----
*.log
logs/

# ---- Node (just in case someone adds a bundler later) ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
