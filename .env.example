# NVIDIA NIM API key (OpenAI-compatible).
# Get one free at https://build.nvidia.com/ → "Get API Key"
# Copy this file to .env and paste your key below.
NVIDIA_API_KEY=nvapi-REPLACE_WITH_YOUR_KEY

# Optional: override the model. Default is nvidia/nemotron-3.5-bolt-e4b
# (fast, clean JSON output, no reasoning overhead). Other options confirmed
# available on the free tier: nvidia/nemotron-3.5-super-vl-120b-a12b (120B
# reasoning model, slower, reasoning_content), nvidia/nemotron-3-ultra-550b-a55b.
# NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b
